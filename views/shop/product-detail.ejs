<%- include('partials/header-dynamic', { title: (typeof product !== 'undefined' ? product.name + ' - EvoMart' : 'Product Details'), page: 'product-detail' }) %>

<style>
  .product-detail-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: var(--text-gray);
  }

  .breadcrumb a {
    color: var(--text-gray);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb-separator {
    color: var(--text-light);
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    background: white;
    border-radius: 24px;
    padding: 3rem;
    border: 1px solid var(--border);
  }

  .product-images {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .main-image {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(135deg, #E8EBFE 0%, #F3F4F6 100%);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12rem;
    position: relative;
    overflow: hidden;
  }

  .product-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: var(--primary);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 24px;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-badge.sale {
    background: var(--error);
  }

  .thumbnail-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .thumbnail {
    aspect-ratio: 1;
    background: var(--bg-gray);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }

  .thumbnail:hover,
  .thumbnail.active {
    border-color: var(--primary);
  }

  .product-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .product-category-tag {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    background: var(--primary-light);
    color: var(--primary);
    border-radius: 20px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    width: fit-content;
  }

  .product-title {
    font-family: 'Syne', sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stars {
    color: #F59E0B;
    font-size: 1.25rem;
  }

  .rating-text {
    font-size: 0.9375rem;
    color: var(--text-gray);
  }

  .product-price-section {
    padding: 1.5rem;
    background: var(--bg-gray);
    border-radius: 16px;
  }

  .product-price {
    font-family: 'Syne', sans-serif;
    font-size: 3rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
  }

  .price-original {
    font-size: 1.25rem;
    color: var(--text-light);
    text-decoration: line-through;
    margin-left: 1rem;
  }

  .price-savings {
    font-size: 0.875rem;
    color: var(--success);
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .product-seller {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg-gray);
    border-radius: 12px;
  }

  .seller-avatar {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 1.25rem;
  }

  .seller-info {
    flex: 1;
  }

  .seller-label {
    font-size: 0.75rem;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .seller-name {
    font-weight: 700;
    color: var(--text-dark);
    font-size: 1rem;
  }

  .seller-link {
    color: var(--primary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .product-description {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-gray);
  }

  .product-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--text-dark);
  }

  .feature-icon {
    color: var(--success);
    font-size: 1.25rem;
  }

  .stock-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: #D1FAE5;
    color: #065F46;
    border-radius: 12px;
    font-weight: 600;
  }

  .stock-status.low {
    background: #FEF3C7;
    color: #92400E;
  }

  .stock-status.out {
    background: #FEE2E2;
    color: #991B1B;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .quantity-label {
    font-weight: 600;
    color: var(--text-dark);
  }

  .quantity-controls {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .qty-btn {
    width: 40px;
    height: 40px;
    background: var(--bg-gray);
    border: none;
    cursor: pointer;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-dark);
    transition: all 0.2s ease;
  }

  .qty-btn:hover {
    background: var(--primary-light);
    color: var(--primary);
  }

  .qty-input {
    width: 60px;
    height: 40px;
    border: none;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    text-align: center;
    font-weight: 600;
    font-size: 1rem;
    font-family: 'Outfit', sans-serif;
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn-add-cart {
    flex: 2;
    padding: 1rem 2rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(66, 93, 246, 0.3);
  }

  .btn-add-cart:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(66, 93, 246, 0.4);
  }

  .btn-buy-now {
    flex: 1;
    padding: 1rem 2rem;
    background: white;
    color: var(--primary);
    border: 2px solid var(--primary);
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-buy-now:hover {
    background: var(--primary);
    color: white;
  }

  .product-tabs {
    margin-top: 3rem;
  }

  .tab-headers {
    display: flex;
    gap: 2rem;
    border-bottom: 2px solid var(--border);
    margin-bottom: 2rem;
  }

  .tab-header {
    padding: 1rem 0;
    font-weight: 600;
    color: var(--text-gray);
    cursor: pointer;
    transition: all 0.2s ease;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
  }

  .tab-header:hover,
  .tab-header.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  .tab-content {
    display: none;
    padding: 2rem;
    background: white;
    border-radius: 16px;
    border: 1px solid var(--border);
  }

  .tab-content.active {
    display: block;
  }

  .spec-table {
    width: 100%;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    padding: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .spec-row:last-child {
    border-bottom: none;
  }

  .spec-label {
    font-weight: 600;
    color: var(--text-dark);
  }

  .spec-value {
    color: var(--text-gray);
  }

  @media (max-width: 768px) {
    .product-layout {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .product-title {
      font-size: 1.75rem;
    }

    .product-price {
      font-size: 2rem;
    }

    .main-image {
      font-size: 8rem;
    }

    .action-buttons {
      flex-direction: column;
    }

    .btn-add-cart,
    .btn-buy-now {
      width: 100%;
    }
  }
</style>

<div class="product-detail-container">
  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-separator">›</span>
    <% if (typeof product !== 'undefined' && product.category) { %>
      <a href="/products?category=<%= product.category %>"><%= product.category %></a>
      <span class="breadcrumb-separator">›</span>
    <% } %>
    <span><%= typeof product !== 'undefined' ? product.name : 'Product' %></span>
  </nav>

  <% if (typeof product !== 'undefined' && product) { %>
    <div class="product-layout">
      <!-- Product Images -->
      <div class="product-images">
        <div class="main-image">
          <% if (product.badge) { %>
            <span class="product-badge <%= product.badge === 'Sale' ? 'sale' : '' %>"><%= product.badge %></span>
          <% } %>
          <span id="mainImageEmoji"><%= product.emoji || '📦' %></span>
        </div>
        <div class="thumbnail-list">
          <div class="thumbnail active" data-emoji="<%= product.emoji || '📦' %>">
            <%= product.emoji || '📦' %>
          </div>
          <div class="thumbnail" data-emoji="📸">📸</div>
          <div class="thumbnail" data-emoji="🔍">🔍</div>
          <div class="thumbnail" data-emoji="✨">✨</div>
        </div>
      </div>

      <!-- Product Details -->
      <div class="product-details">
        <span class="product-category-tag"><%= product.category || 'General' %></span>
        
        <h1 class="product-title"><%= product.name %></h1>
        
        <div class="product-rating">
          <div class="stars">★★★★☆</div>
          <span class="rating-text">4.5 (128 reviews)</span>
        </div>

        <div class="product-price-section">
          <div>
            <span class="product-price">$<%= product.price %></span>
            <% if (product.originalPrice) { %>
              <span class="price-original">$<%= product.originalPrice %></span>
            <% } %>
          </div>
          <% if (product.originalPrice) { %>
            <div class="price-savings">
              Save $<%= (product.originalPrice - product.price).toFixed(2) %> 
              (<%= Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100) %>% off)
            </div>
          <% } %>
        </div>

        <!-- Seller Info -->
        <div class="product-seller">
          <div class="seller-avatar">
            <%= product.sellerName ? product.sellerName.charAt(0).toUpperCase() : 'S' %>
          </div>
          <div class="seller-info">
            <div class="seller-label">Sold by</div>
            <div class="seller-name"><%= product.sellerName || 'EvoMart Seller' %></div>
          </div>
          <a href="/seller/<%= product.sellerId %>" class="seller-link">View Store →</a>
        </div>

        <p class="product-description">
          <%= product.description || 'Premium quality product crafted with attention to detail. Perfect for everyday use and special occasions. Backed by our satisfaction guarantee.' %>
        </p>

        <!-- Product Features -->
        <div class="product-features">
          <div class="feature-item">
            <span class="feature-icon">✓</span>
            <span>Free shipping on orders over $50</span>
          </div>
          <div class="feature-item">
            <span class="feature-icon">✓</span>
            <span>30-day return policy</span>
          </div>
          <div class="feature-item">
            <span class="feature-icon">✓</span>
            <span>Secure payment processing</span>
          </div>
          <div class="feature-item">
            <span class="feature-icon">✓</span>
            <span>Customer support available 24/7</span>
          </div>
        </div>

        <!-- Stock Status -->
        <div class="stock-status <%= product.stock > 10 ? '' : (product.stock > 0 ? 'low' : 'out') %>">
          <% if (product.stock > 10) { %>
            ✓ In Stock - Ready to ship
          <% } else if (product.stock > 0) { %>
            ⚠ Only <%= product.stock %> left in stock
          <% } else { %>
            ✕ Out of Stock
          <% } %>
        </div>

        <!-- Quantity Selector -->
        <% if (product.stock > 0) { %>
          <div class="quantity-selector">
            <span class="quantity-label">Quantity:</span>
            <div class="quantity-controls">
              <button class="qty-btn" onclick="decreaseQty()">−</button>
              <input type="number" id="quantity" class="qty-input" value="1" min="1" max="<%= product.stock %>" readonly>
              <button class="qty-btn" onclick="increaseQty()">+</button>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="action-buttons">
            <button class="btn-add-cart" onclick="addToCart()">
              🛒 Add to Cart
            </button>
            <button class="btn-buy-now" onclick="buyNow()">
              Buy Now
            </button>
          </div>
        <% } else { %>
          <button class="btn-add-cart" style="opacity: 0.6;" disabled>
            Out of Stock
          </button>
        <% } %>
      </div>
    </div>

    <!-- Product Tabs -->
    <div class="product-tabs">
      <div class="tab-headers">
        <div class="tab-header active" data-tab="description">Description</div>
        <div class="tab-header" data-tab="specifications">Specifications</div>
        <div class="tab-header" data-tab="reviews">Reviews (128)</div>
      </div>

      <div class="tab-content active" id="description">
        <h3 style="margin-bottom: 1rem; font-family: 'Syne', sans-serif; font-size: 1.5rem;">Product Description</h3>
        <p style="line-height: 1.8; color: var(--text-gray);">
          <%= product.longDescription || product.description || 'This premium product is designed to meet the highest standards of quality and performance. Crafted from the finest materials and built to last, it combines functionality with elegant design. Whether you\'re using it for everyday tasks or special occasions, this product delivers exceptional results every time. Our commitment to excellence ensures that you receive only the best, backed by our comprehensive warranty and customer support.' %>
        </p>
      </div>

      <div class="tab-content" id="specifications">
        <div class="spec-table">
          <div class="spec-row">
            <div class="spec-label">Brand</div>
            <div class="spec-value"><%= product.brand || 'EvoMart' %></div>
          </div>
          <div class="spec-row">
            <div class="spec-label">Model</div>
            <div class="spec-value"><%= product.model || 'Standard Model' %></div>
          </div>
          <div class="spec-row">
            <div class="spec-label">Category</div>
            <div class="spec-value"><%= product.category || 'General' %></div>
          </div>
          <div class="spec-row">
            <div class="spec-label">SKU</div>
            <div class="spec-value"><%= product._id %></div>
          </div>
          <div class="spec-row">
            <div class="spec-label">Weight</div>
            <div class="spec-value"><%= product.weight || '1.5 kg' %></div>
          </div>
          <div class="spec-row">
            <div class="spec-label">Dimensions</div>
            <div class="spec-value"><%= product.dimensions || '30 x 20 x 10 cm' %></div>
          </div>
        </div>
      </div>

      <div class="tab-content" id="reviews">
        <h3 style="margin-bottom: 1rem; font-family: 'Syne', sans-serif; font-size: 1.5rem;">Customer Reviews</h3>
        <p style="color: var(--text-gray);">Reviews will be displayed here.</p>
      </div>
    </div>
  <% } else { %>
    <div class="empty-state" style="margin-top: 3rem;">
      <div class="empty-icon">📦</div>
      <h3 class="empty-title">Product Not Found</h3>
      <p class="empty-text">The product you're looking for doesn't exist or has been removed.</p>
      <a href="/" class="cta-button cta-primary">Back to Home</a>
    </div>
  <% } %>
</div>

<script>
  const maxStock =  typeof product !== 'undefined' ? product.stock : 0 ;
  const productId =  typeof product !== 'undefined' ? product._id : '' %>';

  function increaseQty() {
    const qtyInput = document.getElementById('quantity');
    const currentValue = parseInt(qtyInput.value);
    if (currentValue < maxStock) {
      qtyInput.value = currentValue + 1;
    }
  }

  function decreaseQty() {
    const qtyInput = document.getElementById('quantity');
    const currentValue = parseInt(qtyInput.value);
    if (currentValue > 1) {
      qtyInput.value = currentValue - 1;
    }
  }

  async function addToCart() {
    const quantity = parseInt(document.getElementById('quantity').value);
    
    try {
      const response = await fetch('/api/cart/add', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ productId, quantity })
      });

      if (response.ok) {
        const result = await response.json();
        showNotification(`Added ${quantity} item(s) to cart!`, 'success');
        
        // Update cart badge
        const cartBadge = document.querySelector('.cart-badge');
        if (cartBadge) {
          cartBadge.textContent = result.totalItems;
        }
      } else {
        const error = await response.json();
        showNotification(error.message || 'Failed to add to cart', 'error');
      }
    } catch (error) {
      console.error('Error:', error);
      showNotification('Please sign in to add items to cart', 'error');
    }
  }

  function buyNow() {
    const quantity = parseInt(document.getElementById('quantity').value);
    // Add to cart and redirect to checkout
    addToCart().then(() => {
      setTimeout(() => {
        window.location.href = '/checkout';
      }, 500);
    });
  }

  function showNotification(message, type = 'success') {
    const notification = document.createElement('div');
    notification.style.cssText = `
      position: fixed;
      top: 100px;
      right: 20px;
      background: ${type === 'success' ? '#10B981' : '#EF4444'};
      color: white;
      padding: 1rem 1.5rem;
      border-radius: 12px;
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
      z-index: 9999;
      animation: slideIn 0.3s ease;
    `;
    notification.textContent = message;
    document.body.appendChild(notification);

    setTimeout(() => {
      notification.style.animation = 'slideOut 0.3s ease';
      setTimeout(() => notification.remove(), 300);
    }, 3000);
  }

  // Tab functionality
  const tabHeaders = document.querySelectorAll('.tab-header');
  const tabContents = document.querySelectorAll('.tab-content');

  tabHeaders.forEach(header => {
    header.addEventListener('click', () => {
      const tabName = header.getAttribute('data-tab');
      
      tabHeaders.forEach(h => h.classList.remove('active'));
      tabContents.forEach(c => c.classList.remove('active'));
      
      header.classList.add('active');
      document.getElementById(tabName).classList.add('active');
    });
  });

  // Thumbnail functionality
  const thumbnails = document.querySelectorAll('.thumbnail');
  const mainImageEmoji = document.getElementById('mainImageEmoji');

  thumbnails.forEach(thumb => {
    thumb.addEventListener('click', () => {
      thumbnails.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
      mainImageEmoji.textContent = thumb.getAttribute('data-emoji');
    });
  });
</script>

<%- include('partials/footer') %>

<%- include('../components/head.ejs') %>
    <link rel="stylesheet" href="/css/products.css">
    </head>
<body>
<div class="orders-hero">
  <div class="orders-hero-content">
    <h1 class="orders-title">My Orders</h1>
    <p class="orders-subtitle">Track and manage all your orders in one place</p>
  </div>
</div>

<div class="orders-container">
  <div class="orders-filters">
    <button class="filter-tab active">All Orders</button>
    <button class="filter-tab">Processing</button>
    <button class="filter-tab">Shipped</button>
    <button class="filter-tab">Delivered</button>
    <button class="filter-tab">Cancelled</button>
  </div>

  <div class="orders-list">
    <!-- Order 1 -->
    <div class="order-card">
      <div class="order-header">
        <div class="order-info">
          <div class="order-detail">
            <span class="order-label">Order ID</span>
            <span class="order-value">#ORD-2024-1547</span>
          </div>
          <div class="order-detail">
            <span class="order-label">Order Date</span>
            <span class="order-value">Jan 28, 2026</span>
          </div>
          <div class="order-detail">
            <span class="order-label">Total Items</span>
            <span class="order-value">3 items</span>
          </div>
        </div>
        <span class="order-status status-shipped">Shipped</span>
      </div>
      <div class="order-body">
        <div class="order-items">
          <div class="order-item">
            <div class="item-image">🎧</div>
            <div class="item-details">
              <div class="item-name">Wireless Headphones Pro</div>
              <div class="item-meta">Quantity: 1 • Black</div>
            </div>
            <div class="item-price">$249</div>
          </div>
          <div class="order-item">
            <div class="item-image">📱</div>
            <div class="item-details">
              <div class="item-name">Smartphone X Pro</div>
              <div class="item-meta">Quantity: 1 • 256GB</div>
            </div>
            <div class="item-price">$899</div>
          </div>
          <div class="order-item">
            <div class="item-image">⌚</div>
            <div class="item-details">
              <div class="item-name">Fitness Smartwatch</div>
              <div class="item-meta">Quantity: 1 • Silver</div>
            </div>
            <div class="item-price">$299</div>
          </div>
        </div>
        <div class="order-footer">
          <div class="order-total">
            <span class="total-label">Order Total</span>
            <span class="total-amount">$1,447</span>
          </div>
          <div class="order-actions">
            <button class="btn-track">Track Order</button>
            <button class="btn-reorder">Reorder</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Order 2 -->
    <div class="order-card">
      <div class="order-header">
        <div class="order-info">
          <div class="order-detail">
            <span class="order-label">Order ID</span>
            <span class="order-value">#ORD-2024-1489</span>
          </div>
          <div class="order-detail">
            <span class="order-label">Order Date</span>
            <span class="order-value">Jan 24, 2026</span>
          </div>
          <div class="order-detail">
            <span class="order-label">Total Items</span>
            <span class="order-value">2 items</span>
          </div>
        </div>
        <span class="order-status status-delivered">Delivered</span>
      </div>
      <div class="order-body">
        <div class="order-items">
          <div class="order-item">
            <div class="item-image">👕</div>
            <div class="item-details">
              <div class="item-name">Premium Cotton T-Shirt</div>
              <div class="item-meta">Quantity: 2 • Navy Blue, Large</div>
            </div>
            <div class="item-price">$90</div>
          </div>
          <div class="order-item">
            <div class="item-image">🎒</div>
            <div class="item-details">
              <div class="item-name">Travel Backpack</div>
              <div class="item-meta">Quantity: 1 • Charcoal Gray</div>
            </div>
            <div class="item-price">$89</div>
          </div>
        </div>
        <div class="order-footer">
          <div class="order-total">
            <span class="total-label">Order Total</span>
            <span class="total-amount">$179</span>
          </div>
          <div class="order-actions">
            <button class="btn-track">View Details</button>
            <button class="btn-reorder">Buy Again</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Order 3 -->
    <div class="order-card">
      <div class="order-header">
        <div class="order-info">
          <div class="order-detail">
            <span class="order-label">Order ID</span>
            <span class="order-value">#ORD-2024-1423</span>
          </div>
          <div class="order-detail">
            <span class="order-label">Order Date</span>
            <span class="order-value">Jan 19, 2026</span>
          </div>
          <div class="order-detail">
            <span class="order-label">Total Items</span>
            <span class="order-value">4 items</span>
          </div>
        </div>
        <span class="order-status status-processing">Processing</span>
      </div>
      <div class="order-body">
        <div class="order-items">
          <div class="order-item">
            <div class="item-image">☕</div>
            <div class="item-details">
              <div class="item-name">Smart Coffee Maker</div>
              <div class="item-meta">Quantity: 1 • Stainless Steel</div>
            </div>
            <div class="item-price">$179</div>
          </div>
          <div class="order-item">
            <div class="item-image">💡</div>
            <div class="item-details">
              <div class="item-name">Smart LED Bulbs (4-Pack)</div>
              <div class="item-meta">Quantity: 2 • White + RGB</div>
            </div>
            <div class="item-price">$138</div>
          </div>
          <div class="order-item">
            <div class="item-image">🛋️</div>
            <div class="item-details">
              <div class="item-name">Modern Accent Chair</div>
              <div class="item-meta">Quantity: 1 • Navy Velvet</div>
            </div>
            <div class="item-price">$329</div>
          </div>
        </div>
        <div class="order-footer">
          <div class="order-total">
            <span class="total-label">Order Total</span>
            <span class="total-amount">$646</span>
          </div>
          <div class="order-actions">
            <button class="btn-track">Track Order</button>
            <button class="btn-reorder">Cancel</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

 <%- include('../components/end.ejs') %>
